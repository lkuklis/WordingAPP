<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Wording.Shell;assembly=Wording.Shell"
        x:Class="Wording.Desktop.MainWindow"
        Title="Wording"
        Width="760" Height="560"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,3*,Auto" Margin="0,0,0,12">
            <TextBox x:Name="OriginalBox" Grid.Column="0" PlaceholderText="Word" Margin="0,0,8,0" />
            <TextBox x:Name="TranslationBox" Grid.Column="1" PlaceholderText="Translation" Margin="0,0,8,0" />
            <Button x:Name="AddButton" Grid.Column="2" Content="Add" MinWidth="80" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   FontSize="11"
                   Opacity="0.6"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="Selected word:" VerticalAlignment="Center" Opacity="0.7" />
            <Button x:Name="GoodButton" Content="I know it" />
            <Button x:Name="HardButton" Content="Hard" />
            <Button x:Name="AgainButton" Content="Don't know" />
            <Button x:Name="DeleteButton" Content="Delete" />
        </StackPanel>

        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="2*,3*,90,90,110"
              Margin="12,0,12,6">
            <TextBlock Grid.Column="0" Text="WORD" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
            <TextBlock Grid.Column="1" Text="TRANSLATION" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="REVIEWS" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
            <TextBlock Grid.Column="3" Text="LAPSES" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
            <TextBlock Grid.Column="4" Text="NEXT REVIEW" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
        </Grid>

        <ListBox x:Name="WordsList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:WordRow">
                    <Grid ColumnDefinitions="2*,3*,90,90,110">
                        <TextBlock Grid.Column="0" Text="{Binding Word}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Translation}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Reviews}" Opacity="0.7" />
                        <TextBlock Grid.Column="3" Text="{Binding Lapses}" Opacity="0.7" />
                        <TextBlock Grid.Column="4" Text="{Binding NextReview}" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
