<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wording.Core</RootNamespace>
    <AssemblyTitle>Wording.Core</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Intentionally not -windows: all logic must stay platform independent and
         testable on macOS. Core reads no configuration - the app layer injects it. -->
  </PropertyGroup>

  <!-- Nothing is shipped next to the binary any more. A WordsData.xml used to live
       here as the starter pack, but FindLegacyXml looks in AppContext.BaseDirectory
       first, so our copy shadowed the file of anyone migrating from a pre-2026
       install - they got our words instead of theirs. -->

  <ItemGroup>
    <!-- The tests assert on selector weights, which are an implementation detail
         and should not widen the public API. -->
    <InternalsVisibleTo Include="Wording.Core.Tests" />
  </ItemGroup>

</Project>
