<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wording.Core</RootNamespace>
    <AssemblyTitle>Wording.Core</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Intentionally not -windows: all logic must stay platform independent and
         testable on macOS. Core reads no configuration - the app layer injects it. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Starter pack of English->Polish words. Also the source for the one-off
         migration from the legacy XML format to words.json. -->
    <Content Include="WordsData.xml" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests assert on selector weights, which are an implementation detail
         and should not widen the public API. -->
    <InternalsVisibleTo Include="Wording.Core.Tests" />
  </ItemGroup>

</Project>
